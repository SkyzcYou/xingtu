# Copy to backend/.env for local development. Do not commit real secrets.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=postgres://xingtu_user:<password>@139.199.157.177:5543/xingtu
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=0
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
LLM_CONFIG_CACHE_TTL_SECONDS=30
PAYMENT_PROVIDER=qingke
QINGKE_API_BASE=https://pay.xianlai.work
QINGKE_PID=<merchant_id>
QINGKE_MERCHANT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
QINGKE_PLATFORM_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# NoiPay RESTful v1. Set PAYMENT_PROVIDER=noipay to use it.
# In NoiPay dashboard configure Webhook URL to: ${PUBLIC_BASE_URL}/api/pay/notify
# Subscribe at least: payment.succeeded, payment.failed, payment.closed, refund.succeeded
NOIPAY_API_BASE=https://api.noipay.net/api
NOIPAY_APP_ID=<np_or_np_test_app_id>
NOIPAY_APP_SECRET=<app_secret>
NOIPAY_WEBHOOK_SECRET=<webhook_secret>
PUBLIC_BASE_URL=https://api.xingtu.live
CORS_ALLOWED_ORIGIN=https://xingtu.live,https://www.xingtu.live,https://console.xingtu.live,http://localhost:7200,http://localhost:5174
TRUST_BASE_URL=https://trust-api.skyzcstack.space
TRUST_REALM=xing
TRUST_CLIENT_IDS=xingtu,xingtu-console
ADMIN_REQUIRED_ROLE=admin
ADMIN_ROLE_CLIENT_ID=xingtu-console
