{
  "name": "backend-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite serve --host 0.0.0.0",
        "cwd": "backend/web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run backend-web:typecheck",
          "nx run backend-web:build-app"
        ],
        "parallel": false
      }
    },
    "build-app": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "backend/web"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "backend/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts",
        "cwd": "backend/web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.app.json --noEmit",
        "cwd": "backend/web"
      }
    }
  }
}
